    "labelCaps": { "$type": "typography", "$value": { "size": 13, "weight": 600, "letterSpacing": 0.06, "lineHeight": 1.2, "uppercase": true } },
    "button": { "$type": "typography", "$value": { "size": 17, "weight": 600, "letterSpacing": 0, "lineHeight": 1.0, "uppercase": false } },
    "buttonS": { "$type": "typography", "$value": { "size": 13, "weight": 500, "letterSpacing": 0, "lineHeight": 1.0, "uppercase": false } },
    "tabLabel": { "$type": "typography", "$value": { "size": 12, "weight": 500, "letterSpacing": 0.04, "lineHeight": 1.0, "uppercase": false } },
    "weekday": { "$type": "typography", "$value": { "size": 12, "weight": 500, "letterSpacing": 0.04, "lineHeight": 1.0, "uppercase": false } },
    "chartLabel": { "$type": "typography", "$value": { "size": 12, "weight": 600, "letterSpacing": 0.04, "lineHeight": 1.0, "uppercase": false } },
    "chartAxis": { "$type": "typography", "$value": { "size": 11, "weight": 400, "letterSpacing": 0.02, "lineHeight": 1.0, "uppercase": false } },
    "key": { "$type": "typography", "$value": { "size": 26, "weight": 400, "letterSpacing": 0, "lineHeight": 1.0, "uppercase": false } }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Inter" },
    "familyHero": { "$type": "fontFamily", "$value": "Inter Display" },
    "weightLight": { "$type": "fontWeight", "$value": 200 },
    "weightRegular": { "$type": "fontWeight", "$value": 400 },
    "weightMedium": { "$type": "fontWeight", "$value": 500 },
    "weightSemibold": { "$type": "fontWeight", "$value": 600 }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": 1 },
    "rimLight": { "$type": "dimension", "$value": 1.25 },
    "focusRing": { "$type": "dimension", "$value": 2 }
  },
  "elevation": {
    "glass": {
      "$type": "elevation",
      "$value": {
        "dark": { "layers": [{ "dx": 0, "dy": 24, "blur": 50, "spread": -30, "color": "#E6000000", "inset": false }] },
        "light": { "layers": [{ "dx": 0, "dy": 18, "blur": 40, "spread": -28, "color": "#59141628", "inset": false }] }
      }
    },
    "sheet": {
      "$type": "elevation",
      "$value": {
        "dark": {
          "layers": [
            { "dx": 0, "dy": -20, "blur": 50, "spread": -10, "color": "#CC000000", "inset": false },
            { "dx": 0, "dy": 1, "blur": 0, "spread": 0, "color": "#14FFFFFF", "inset": true }
          ]
        },
        "light": { "layers": [{ "dx": 0, "dy": -20, "blur": 50, "spread": -10, "color": "#40000000", "inset": false }] }
      }
    },
    "nav": {
      "$type": "elevation",
      "$value": {
        "dark": {
          "fill": "#DB16171B",
          "blur": 20,
          "layers": [
            { "dx": 0, "dy": 1, "blur": 0, "spread": 0, "color": "#14FFFFFF", "inset": true },
            { "dx": 0, "dy": 12, "blur": 30, "spread": -12, "color": "#CC000000", "inset": false }
          ]
        },
        "light": {
          "fill": "#E0FFFFFF",
          "blur": 20,
          "layers": [
            { "dx": 0, "dy": 1, "blur": 0, "spread": 0, "color": "#0F16171B", "inset": true },
            { "dx": 0, "dy": 12, "blur": 30, "spread": -14, "color": "#4D141628", "inset": false }
          ]
        }
      }
    },
    "none": { "$type": "elevation", "$value": { "dark": { "layers": [] }, "light": { "layers": [] } } }
  },
  "glow": {
    "markMaxOpacity": { "$type": "number", "$value": 0.4 },
    "haloRadius": { "$type": "dimension", "$value": 11 },
    "endDotDiameter": { "$type": "dimension", "$value": 4.5 },
    "endDotRing": { "$type": "dimension", "$value": 2 }
  }
}
