# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.ios/
.android/
# Coverage output is evidence, not source (CR-16).
coverage/

# Drift / build_runner output stays ignored.
*.g.dart
# tokens.g.dart is a committed custom-generator artifact: a clean clone must
# build without running a generator (CR-01). Never edit it by hand (AGENTS 3).
# Regenerate with `dart run tool/gen_tokens.dart`; verify with
# `dart run tool/check_tokens.dart`.
!lib/design/tokens/tokens.g.dart

# l10n output
lib/l10n/app_localizations*.dart
.i18n/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store

# Native
Pods/
*.xcworkspace/xcuserdata/
derivedData/

# Secrets — never commit keys (AGENTS 2.7)
*.key
*.p12
*.jks
local.properties

# Local design assets and tooling
design-mockups/
heic/
.commandcode/
