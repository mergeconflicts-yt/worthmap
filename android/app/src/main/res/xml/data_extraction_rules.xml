<?xml version="1.0" encoding="utf-8"?>
<!-- PF-01-ANDROID (N-01): no cloud backup and no device transfer.
     Every domain is excluded for both cloud-backup and device-transfer, so
     the encrypted database and preferences never leave the phone (AGENTS 2.1).
     `android:allowBackup="false"` in the manifest opts out as well. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
